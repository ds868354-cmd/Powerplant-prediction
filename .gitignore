# Generated by the AutoML pipeline -- keeps credentials, personal data and oversized files out of git.
# Credentials: mount api_keys.json as a secret (k8s Secret volume / docker -v). Never commit it, never bake it into the image.
api_keys.json
api_keys.json.lock
# Run metadata and data samples describe / contain REAL training rows and training-machine paths; not needed to serve the model.
pipeline_run_summary.json
local_explanations.json
notebook_data_sample.csv
# NLP bundles: nlp_data_sample.csv holds up to 5000 RAW text rows (names, e-mails, ... can sit inside free text and cannot be
# masked column-wise like the tabular sample), so it is kept out of git too.
nlp_data_sample.csv
unlabeled_rows.*
# Per-row test predictions are routinely > 50 MB (GitHub warns at 50 MiB and rejects files above 100 MiB).
validation_report*.csv
# Keys / certificates / rendered manifests / archives
*.pem
*.key
.env.*
k8s.rendered.yaml
*.zip
*.log
# Tooling
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env
